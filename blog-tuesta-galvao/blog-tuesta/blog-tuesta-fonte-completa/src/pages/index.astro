---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Motif from '../components/Motif.astro';
import { PILARES, PILAR_IMG } from '../data/pilares';
import { SITE } from '../data/site';

const heroImg = 'https://images.unsplash.com/photo-1624204386084-dd8c05e32226?auto=format&fit=crop&w=1000&h=1000&q=80';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const destaque = posts[0];
const recentes = posts.slice(1, 7);
---
<BaseLayout
  title={`${SITE.name} — mercado imobiliário de Curitiba sem enrolação`}
  description={SITE.description}
  path="/"
>
  <section class="hero-home">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Tuesta &amp; Galvão · Curitiba</p>
        <h1>O mercado imobiliário de Curitiba, explicado por quem opera a cidade.</h1>
        <p class="lede">
          Guias diretos sobre alugar, vender, avaliar e investir em imóveis em Curitiba —
          feitos por corretores, com dado de mercado e sem conversa de vendedor.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={SITE.lps.avalie} target="_blank" rel="noopener">Avaliar meu imóvel →</a>
          <a class="btn btn-ghost" href="#guias">Ver os guias</a>
        </div>
      </div>
      <div class="hero-art">
        <img src={heroImg} alt="Prédio residencial moderno" loading="eager" width="500" height="500" />
      </div>
    </div>
  </section>

  {destaque && (
    <section class="wrap" style="padding-block:10px 0">
      <a class="feature" href={`/blog/${destaque.slug}/`}>
        <div class="feature-body">
          <span class="eyebrow">Em destaque</span>
          <h2>{destaque.data.title}</h2>
          <p>{destaque.data.description}</p>
          <span class="feature-link">Ler o guia completo →</span>
        </div>
      </a>
    </section>
  )}

  <section id="guias" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Comece pelo seu objetivo</h2>
        <a href="/sobre/">Quem escreve estes guias →</a>
      </div>
      <div class="grid-cards">
        {PILARES.map((p) => (
          <a class="card card--art pilar-card" href={`/guias/${p.slug}/`}>
            <div class="card-cover">
              {PILAR_IMG[p.slug]
                ? <img src={PILAR_IMG[p.slug].src} alt={PILAR_IMG[p.slug].alt} loading="lazy" width="400" height="118" />
                : <Motif pilar={p.slug} variant="card" />}
            </div>
            <div class="card-body">
              <span class="tag">Guia</span>
              <h3>{p.nav}</h3>
              <p>{p.descricao}</p>
              <span class="meta">Abrir o guia →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {recentes.length > 0 && (
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="section-head"><h2>Últimos artigos</h2></div>
        <div class="grid-cards">
          {recentes.map((post) => (
            <ArticleCard
              url={`/blog/${post.slug}/`}
              title={post.data.title}
              description={post.data.description}
              pilar={post.data.pilar}
              pubDate={post.data.pubDate}
              image={post.data.image}
              imageAlt={post.data.imageAlt}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero-home { padding-block: 56px 34px; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr .9fr; gap: 40px; align-items: center; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; gap: 20px; } .hero-art { display: none; } }
  .hero-home h1 { font-size: clamp(30px, 6vw, 50px); font-weight: 600;
    letter-spacing: -.015em; max-width: 18ch; margin-top: 16px; }
  .hero-home .lede { margin-top: 20px; max-width: 54ch; font-size: 18px; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero-art { border-radius: 18px; overflow: hidden; background: var(--petroleo); aspect-ratio: 1/1; }
  .hero-art img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .feature { display: block; background: var(--surface); border: 1px solid var(--border);
    border-left: 5px solid var(--accent); border-radius: 16px; padding: 30px; }
  .feature:hover { text-decoration: none; border-color: var(--accent); }
  .feature-body h2 { font-size: clamp(22px, 4vw, 30px); font-weight: 600; margin: 10px 0 10px;
    color: var(--fg); max-width: 24ch; }
  .feature-body p { color: var(--muted); max-width: 60ch; font-size: 15.5px; }
  .feature-link { display: inline-block; margin-top: 16px; color: var(--accent-ink); font-weight: 600; }

  .pilar-card { cursor: pointer; }
  .pilar-card:hover { text-decoration: none; }
  .pilar-card h3 { color: var(--fg); }
</style>
