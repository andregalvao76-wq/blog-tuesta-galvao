---
import { PILARES } from '../data/pilares';
import { SITE, WHATSAPP_URL } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <h4>Tuesta &amp; Galvão</h4>
      <p style="font-size:14px;line-height:1.6;max-width:36ch">
        Imobiliária de Curitiba especializada em locação, avaliação e intermediação.
        Conteúdo para quem quer alugar, vender, comprar ou investir na cidade.
      </p>
      <p style="margin-top:14px;font-size:14px">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener">WhatsApp: {SITE.telefoneExibicao}</a><br>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <div class="social">
        <a href={SITE.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.27.06-1.65.07-4.86.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.42-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.17-.42-.37-1.06-.42-2.23C2.21 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.21 8.8 2.2 12 2.2zm0 1.8c-3.14 0-3.5 0-4.74.07-.9.04-1.38.2-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.33-.28.81-.32 1.71C3.4 8.5 3.4 8.86 3.4 12s0 3.5.07 4.74c.04.9.2 1.38.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.33.12.81.28 1.71.32 1.24.07 1.6.07 4.74.07s3.5 0 4.74-.07c.9-.04 1.38-.2 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.33.28-.81.32-1.71.07-1.24.07-1.6.07-4.74s0-3.5-.07-4.74c-.04-.9-.2-1.38-.32-1.71a2.86 2.86 0 0 0-.69-1.06 2.86 2.86 0 0 0-1.06-.69c-.33-.12-.81-.28-1.71-.32C15.5 4 15.14 4 12 4zm0 3.06A4.94 4.94 0 1 1 7.06 12 4.94 4.94 0 0 1 12 7.06zm0 8.15A3.21 3.21 0 1 0 8.79 12 3.21 3.21 0 0 0 12 15.21zm6.3-8.35a1.15 1.15 0 1 1-1.15-1.15 1.15 1.15 0 0 1 1.15 1.15z"/></svg>
        </a>
        <a href={SITE.social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.43-4.94 8.43-9.94z"/></svg>
        </a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5A2.5 2.5 0 1 1 2.5 6 2.5 2.5 0 0 1 4.98 3.5zM2.9 8.4h4.16V21H2.9zM9.5 8.4h3.99v1.72h.06a4.37 4.37 0 0 1 3.93-2.16c4.2 0 4.98 2.77 4.98 6.37V21h-4.16v-5.55c0-1.32-.02-3.02-1.84-3.02-1.85 0-2.13 1.44-2.13 2.93V21H9.5z"/></svg>
        </a>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2.04A9.9 9.9 0 0 0 2.1 11.9a9.8 9.8 0 0 0 1.33 4.94L2 22l5.3-1.38a9.9 9.9 0 0 0 4.7 1.2h.01a9.9 9.9 0 0 0 9.9-9.86A9.9 9.9 0 0 0 12 2.04zm0 17.9a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.1.81.83-3.02-.2-.31a8.2 8.2 0 1 1 6.95 3.85zm4.5-6.15c-.25-.12-1.46-.72-1.68-.8-.23-.08-.39-.12-.55.12-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42l-.47-.01c-.16 0-.43.06-.65.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.12.16 1.73 2.64 4.19 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"/></svg>
        </a>
        <a href={SITE.siteUrl} target="_blank" rel="noopener" aria-label="Site tuestagalvao.com.br">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.93 6h-2.95a15.6 15.6 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a7.96 7.96 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4zm.81 2h2.95c.32 1.25.79 2.45 1.38 3.56A8.03 8.03 0 0 1 5.07 16zm2.95-8H5.07a8.03 8.03 0 0 1 4.33-3.56A15.6 15.6 0 0 0 8.02 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66a14.8 14.8 0 0 1 0-4h4.68a14.8 14.8 0 0 1 0 4zm.26 5.56c.59-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14a16.5 16.5 0 0 0 0-4h3.38a7.96 7.96 0 0 1 0 4z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4>Guias</h4>
      <ul>
        {PILARES.map((p) => <li><a href={`/guias/${p.slug}/`}>{p.nav}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Serviços</h4>
      <ul>
        <li><a href={SITE.lps.avalie} target="_blank" rel="noopener">Avaliar meu imóvel</a></li>
        <li><a href={SITE.lps.anuncie} target="_blank" rel="noopener">Anunciar para alugar</a></li>
        <li><a href={SITE.lps.indique} target="_blank" rel="noopener">Indique e Ganhe</a></li>
        <li><a href={SITE.siteUrl} target="_blank" rel="noopener">Buscar imóveis</a></li>
      </ul>
    </div>
    <div class="legal">
      <span>{SITE.legalName}</span>
      <span>{SITE.creci}</span>
      <span>CNPJ {SITE.cnpj}</span>
      <span>{SITE.endereco.rua}, {SITE.endereco.bairro} — {SITE.endereco.cidade}/{SITE.endereco.uf}</span>
    </div>
  </div>
</footer>
