---
// Arte de linha por pilar — SVG gerado, nas cores da marca (sem foto externa).
// variant 'cover' = capa do artigo/guia; 'card' = miniatura do card.
interface Props { pilar: string; variant?: 'cover' | 'card'; }
const { pilar, variant = 'cover' } = Astro.props;

// Fundo levemente diferente por pilar (tons de petróleo) para dar identidade.
const BG: Record<string, [string, string]> = {
  'alugar-seu-imovel-em-curitiba':       ['#0f3b3e', '#16565a'],
  'vender-e-avaliar-imovel-em-curitiba': ['#0c3134', '#124a4e'],
  'morar-e-investir-em-curitiba':        ['#113f44', '#17585d'],
  'locacao-descomplicada':               ['#0e3639', '#15504f'],
  'arquitetura-decoracao-e-viver-bem':   ['#104548', '#1a5f5c'],
};
const [c1, c2] = BG[pilar] ?? ['#0f3b3e', '#14494d'];
const uid = `${pilar}-${variant}-${Math.random().toString(36).slice(2, 7)}`;

// Arte de linha (stroke dourado) por pilar.
const ART: Record<string, string> = {
  // Prédio + chave
  'alugar-seu-imovel-em-curitiba': `
    <rect x="250" y="70" width="90" height="110" rx="3"/>
    <line x1="268" y1="92" x2="284" y2="92"/><line x1="300" y1="92" x2="322" y2="92"/>
    <line x1="268" y1="116" x2="284" y2="116"/><line x1="300" y1="116" x2="322" y2="116"/>
    <line x1="268" y1="140" x2="284" y2="140"/><line x1="300" y1="140" x2="322" y2="140"/>
    <circle cx="120" cy="110" r="22"/><circle cx="120" cy="110" r="8" fill="currentColor" stroke="none"/>
    <line x1="140" y1="118" x2="196" y2="150"/><line x1="176" y1="139" x2="186" y2="158"/><line x1="190" y1="147" x2="198" y2="162"/>`,
  // Lupa + barras de valorização
  'vender-e-avaliar-imovel-em-curitiba': `
    <line x1="250" y1="170" x2="350" y2="170"/>
    <rect x="258" y="130" width="20" height="40" fill="currentColor" stroke="none" opacity="0.5"/>
    <rect x="288" y="108" width="20" height="62" fill="currentColor" stroke="none" opacity="0.7"/>
    <rect x="318" y="80"  width="20" height="90" fill="currentColor" stroke="none"/>
    <circle cx="120" cy="104" r="34"/><line x1="146" y1="130" x2="180" y2="164"/>
    <path d="M104 108 l12 12 l20 -26" fill="none"/>`,
  // Mapa + pins
  'morar-e-investir-em-curitiba': `
    <path d="M60 70 L150 90 L240 70 L330 92 L330 170 L240 150 L150 170 L60 150 Z"/>
    <line x1="150" y1="90" x2="150" y2="170"/><line x1="240" y1="70" x2="240" y2="150"/>
    <path d="M120 96 c0 14 -14 22 -14 34 c0 -12 -14 -20 -14 -34 a14 14 0 0 1 28 0 Z" fill="currentColor" stroke="none"/>
    <path d="M280 110 c0 12 -12 19 -12 29 c0 -10 -12 -17 -12 -29 a12 12 0 0 1 24 0 Z" fill="currentColor" stroke="none" opacity="0.7"/>`,
  // Contrato + selo
  'locacao-descomplicada': `
    <rect x="120" y="54" width="130" height="150" rx="4"/>
    <line x1="140" y1="86" x2="230" y2="86"/><line x1="140" y1="108" x2="230" y2="108"/>
    <line x1="140" y1="130" x2="230" y2="130"/><line x1="140" y1="152" x2="200" y2="152"/>
    <circle cx="272" cy="168" r="26"/><circle cx="272" cy="168" r="18"/>
    <path d="M264 168 l6 6 l12 -14" fill="none"/>`,
  // Interior: sofá + luminária + planta
  'arquitetura-decoracao-e-viver-bem': `
    <path d="M120 150 v-14 a10 10 0 0 1 10 -10 h70 a10 10 0 0 1 10 10 v14"/>
    <rect x="110" y="150" width="120" height="26" rx="6"/>
    <line x1="120" y1="176" x2="120" y2="188"/><line x1="220" y1="176" x2="220" y2="188"/>
    <line x1="290" y1="54" x2="290" y2="96"/><path d="M274 96 a16 16 0 0 0 32 0 Z" fill="currentColor" stroke="none"/>
    <path d="M300 176 c-10 -26 -4 -44 8 -56 c2 16 10 24 -8 56 Z"/>
    <line x1="304" y1="176" x2="312" y2="176"/>`,
};
const art = ART[pilar] ?? ART['vender-e-avaliar-imovel-em-curitiba'];
const h = variant === 'card' ? 118 : 220;
---
<div class={`motif motif-${variant}`} aria-hidden="true">
  <svg viewBox="0 0 400 220" preserveAspectRatio="xMidYMid slice" style={`height:${h}px`} role="presentation">
    <defs>
      <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={c1}/><stop offset="1" stop-color={c2}/>
      </linearGradient>
    </defs>
    <rect width="400" height="220" fill={`url(#g-${uid})`}/>
    <g stroke="#d9b877" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" set:html={art}></g>
    <circle cx="44" cy="40" r="4" fill="#c9a15a"/>
    <circle cx="368" cy="46" r="3" fill="#c9a15a" opacity="0.6"/>
  </svg>
</div>
<style>
  .motif { width: 100%; overflow: hidden; background: #0f3b3e; }
  .motif svg { width: 100%; display: block; }
  .motif-card { border-radius: 12px 12px 0 0; }
</style>
