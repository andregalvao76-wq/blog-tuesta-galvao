---
import { WHATSAPP_URL, SITE } from '../data/site';
---
<a
  class="wa-float"
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener"
  aria-label={`Falar no WhatsApp com a ${SITE.shortName}`}
  title="Falar no WhatsApp"
>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16.003 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.6 4.46 1.73 6.4L3.2 28.8l6.57-1.71a12.74 12.74 0 0 0 6.23 1.6h.01c7.06 0 12.8-5.74 12.8-12.8s-5.75-12.69-12.81-12.69zm0 23.02h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.9 1.02 1.04-3.8-.25-.39a10.56 10.56 0 0 1-1.62-5.64c0-5.86 4.77-10.63 10.64-10.63 2.84 0 5.51 1.11 7.52 3.12a10.57 10.57 0 0 1 3.11 7.52c0 5.87-4.77 10.63-10.63 10.63zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.18.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.71-.97-2.35-.26-.62-.52-.53-.71-.54l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.64 0 1.56 1.14 3.06 1.3 3.27.16.21 2.25 3.44 5.45 4.82.76.33 1.35.52 1.82.67.76.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.74.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37z"/>
  </svg>
</a>
<style>
  .wa-float{
    position:fixed;
    right:18px;
    bottom:calc(18px + env(safe-area-inset-bottom,0px));
    z-index:60;
    width:56px;height:56px;border-radius:50%;
    background:#25d366;color:#fff;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 6px 20px rgba(0,0,0,.25);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .wa-float:hover{transform:scale(1.06);box-shadow:0 8px 26px rgba(0,0,0,.3);text-decoration:none;}
  .wa-float:focus-visible{outline:3px solid #0f3b3e;outline-offset:3px;}
  @media (max-width:480px){.wa-float{width:52px;height:52px;right:14px;}}
  @media print{.wa-float{display:none;}}
</style>
